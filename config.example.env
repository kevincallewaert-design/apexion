# APEXION v0.1.7 canonical environment namespace. Legacy AEGIS_* keys remain read-compatible.
# AEGIS SAFE LOCAL DEVELOPMENT EXAMPLE
# Live trading is disabled by default. Do not enable it without a separate review.

APEXION_MODE=paper
APEXION_LIVE_EXECUTION_ENABLED=false
APEXION_MICRO_LIVE_ARM=
APEXION_APPROVAL_REQUIRED=true
APEXION_AUTO_EXECUTE_PAPER=true
APEXION_AUTO_EXECUTE_PAPER_ROTATION=true
APEXION_ROTATION_COST_TO_QUALITY_MULTIPLIER=2.5
APEXION_ROTATION_RISK_EDGE_COVER_RATIO=0.35
APEXION_ROTATION_MIN_NET_EDGE_POINTS=2.0

# Bind only to the local machine.
APEXION_HOST=127.0.0.1
APEXION_PORT=8000

# Replace these placeholders locally in .env. Never commit real credentials.
APEXION_USERNAME=replace-with-local-username
APEXION_PASSWORD=replace-with-a-strong-local-password
APEXION_SECRET_KEY=replace-with-a-random-local-secret

# Exchange credentials intentionally remain empty.
APEXION_PIONEX_API_KEY=
APEXION_PIONEX_API_SECRET=
APEXION_PIONEX_BASE_URL=https://api.pionex.com
APEXION_PIONEX_PUBLIC_WS_URL=wss://ws.pionex.com/wsPub
APEXION_PIONEX_PRIVATE_WS_URL=wss://ws.pionex.com/ws
APEXION_MARKET_STREAM_ENABLED=true
APEXION_MARKET_STREAM_AUTO_START=true
# Private ORDER/FILL/BALANCE is read-only but remains opt-in.
APEXION_MARKET_STREAM_PRIVATE_ENABLED=false
APEXION_MARKET_STREAM_DEPTH_LEVELS=10
APEXION_MARKET_STREAM_STALE_SECONDS=20

# Conservative local defaults.
APEXION_SCHEDULER_AUTO_START=false
APEXION_SCHEDULER_INTERVAL_MINUTES=15
APEXION_PAPER_EXECUTION_INTERVAL_SECONDS=15
APEXION_PAPER_EXECUTION_MISFIRE_GRACE_SECONDS=5
APEXION_SCHEDULER_MISFIRE_GRACE_SECONDS=120
APEXION_PAPER_EXECUTION_INTERVAL_SECONDS=15
APEXION_PAPER_EXECUTION_MISFIRE_GRACE_SECONDS=5
APEXION_SCHEDULER_MISFIRE_GRACE_SECONDS=120
APEXION_MAX_ACTIVE_BOTS=3
APEXION_MAX_ACTIVE_EXECUTIONS=3
APEXION_MAX_GRID_DCA_POSITIONS=2
APEXION_RESERVED_SPOT_SLOTS=1
APEXION_MAX_ONE_POSITION_PER_COIN=true
APEXION_DEFAULT_INVESTMENT_USDT=10
APEXION_MAX_PER_COIN_USDT=10
APEXION_MAX_TOTAL_EXPOSURE_USDT=50
APEXION_LIVE_MAX_ORDER_USDT=10
APEXION_LIVE_MAX_DEPLOYED_USDT=25
APEXION_LIVE_MAX_ENVELOPE_USDT=50
APEXION_LIVE_MAX_POSITIONS=1
APEXION_LIVE_DAILY_LOSS_LIMIT_USDT=5
APEXION_RESERVE_RATIO=0.25
APEXION_DYNAMIC_CAPITAL_ALLOCATION_ENABLED=true
APEXION_MAX_PORTFOLIO_DEPLOYED_RATIO=0.50
APEXION_MAX_SINGLE_POSITION_RATIO=0.20
APEXION_MAX_SINGLE_GRID_RATIO=0.20
APEXION_MIN_CASH_RESERVE_RATIO=0.25
APEXION_MAX_ASSET_CLASS_EXPOSURE_RATIO=0.50
APEXION_MAX_CORRELATED_EXPOSURE_RATIO=0.15
APEXION_PAPER_GRID_MIN_ECONOMIC_ORDER_USDT=5.0
APEXION_PAPER_MICRO_GRID_ENABLED=true
APEXION_PAPER_MICRO_GRID_MAX_EQUITY_USDT=100
APEXION_PAPER_MICRO_GRID_MAX_ALLOCATION_RATIO=0.70

# Centrale PAPER execution-kosten (0.0005 = 0.05%). Niet op nul zetten.
APEXION_PAPER_MAKER_FEE_RATE=0.0005
APEXION_PAPER_TAKER_FEE_RATE=0.0005
APEXION_PAPER_SLIPPAGE_RATE=0.0003
APEXION_PAPER_MAKER_SLIPPAGE_RATE=0.0
APEXION_PAPER_MIN_GRID_NET_PROFIT_PCT=0.05
APEXION_PAPER_GRID_ACTIVITY_STALE_MINUTES=30
APEXION_PAPER_GRID_ACTIVITY_MIN_MOVEMENT_PCT=0.50
APEXION_PAPER_GRID_ACTIVITY_MIN_IMPROVEMENT_PCT=0.01
APEXION_PAPER_GRID_REBUILD_PAYBACK_HOURS=4
APEXION_PAPER_GRID_REBUILD_COOLDOWN_MINUTES=60
APEXION_PAPER_GRID_INVENTORY_SKEW_ENABLED=true
APEXION_PAPER_GRID_INVENTORY_TARGET_BASE_RATIO=0.50
APEXION_PAPER_GRID_INVENTORY_MAX_BASE_RATIO=0.78
APEXION_PAPER_GRID_FILLED_ORDER_DELAY_SECONDS=45
APEXION_PAPER_GRID_STRESS_BUY_COOLDOWN_SECONDS=120
APEXION_PAPER_GRID_ORDER_REFRESH_TOLERANCE_PCT=0.12
APEXION_PAPER_GRID_ADVERSE_SELECTION_ENABLED=true
APEXION_PAPER_GRID_ADVERSE_BOOK_IMBALANCE=0.35
APEXION_PAPER_GRID_ADVERSE_TRADE_IMBALANCE=0.45
APEXION_PAPER_GRID_MAX_MARKET_SPREAD_PCT=0.40
APEXION_PAPER_GRID_MAX_ENTRY_BREAKOUT_RISK=0.55
APEXION_PAPER_GRID_BLOCK_RISK_OFF_BEARISH_ENTRY=true
APEXION_PAPER_EXECUTION_INTERVAL_SECONDS=15
APEXION_PAPER_SPOT_TRAILING_ACTIVATION_PCT=1.0
APEXION_PAPER_SPOT_TRAILING_DISTANCE_PCT=0.9
APEXION_PAPER_SPOT_MIN_ROTATION_IMPROVEMENT_PCT=0.25
APEXION_PAPER_SPOT_MIN_HOLD_MINUTES=30
APEXION_PAPER_SPOT_EDGE_DECAY_SCORE=35
APEXION_INTELLIGENCE_ENTRY_TIMEFRAME=15m
APEXION_INTELLIGENCE_SETUP_TIMEFRAME=1h
APEXION_INTELLIGENCE_REGIME_TIMEFRAME=4h
APEXION_INTELLIGENCE_CANDLE_LIMIT=180
APEXION_INTELLIGENCE_HISTORICAL_MIN_SAMPLES=12
APEXION_INTELLIGENCE_HISTORICAL_MAX_SAMPLES=40
APEXION_INTELLIGENCE_HISTORICAL_FORWARD_BARS=8
APEXION_INTELLIGENCE_EXPERIENCE_MIN_SAMPLES=12
APEXION_INTELLIGENCE_MIN_CONFLUENCE_SCORE=0.52
APEXION_INTELLIGENCE_MIN_NET_EDGE_PCT=0.20
APEXION_MARKET_METADATA_CACHE_SECONDS=300
APEXION_MARKET_CANDLE_CACHE_SECONDS=90
APEXION_MARKET_RATE_LIMIT_MIN_INTERVAL_MS=100
APEXION_MARKET_RATE_LIMIT_MAX_RETRIES=2
APEXION_MARKET_RATE_LIMIT_BACKOFF_SECONDS=0.20
APEXION_MARKET_RATE_LIMIT_COOLDOWN_SECONDS=120

# Fresh GEX is a read-only spot strategy router. Missing/stale context falls
# back to the normal price engine in PAPER; transition/wall entries wait.
APEXION_GEX_STRATEGY_ROUTER_ENABLED=true
APEXION_GEX_CONTEXT_TTL_SECONDS=1800
APEXION_GEX_BLOCK_NEAR_WALL_ENTRY=true
APEXION_GEX_WALL_ENTRY_BLOCK_PCT=0.30
APEXION_GEX_BLOCK_GAMMA_TRANSITION_ENTRY=true
